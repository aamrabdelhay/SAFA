{
  "buildCommand": "node server/migrate.js && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/blob", "destination": "/api/blob.js" },
    { "source": "/api/blob/:path*", "destination": "/api/blob.js?path=:path*" },
    { "source": "/api/admin/categories", "destination": "/api/admin-categories.js" },
    { "source": "/api/admin/login", "destination": "/api/admin-login.js" },
    { "source": "/api/admin-archive", "destination": "/api/admin-archive.js" },
    { "source": "/api/logo-config", "destination": "/api/logo-config.js" },
    { "source": "/api/orders", "destination": "/api/orders.js" },
    { "source": "/api/beauty-advisor", "destination": "/api/beauty-advisor.js" },
    { "source": "/api/analytics-visit", "destination": "/api/analytics-visit.js" },
    { "source": "/api/admin-visitor-stats", "destination": "/api/admin-visitor-stats.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "trailingSlash": false
}
